# ==========================================
# ProjectPulse Environment Configuration
# ==========================================

# Web Server Port (default: 8000)
PORT=8000

# Microsoft Outlook / Office 365 SMTP Settings
SMTP_PROVIDER=outlook
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_organization_email@yourcompany.com
SMTP_PASS=your_app_password_or_token
SENDER_NAME=ProjectPulse Notifications
